# Public/build-time defaults
NEXT_PUBLIC_BUSINESS_NAME=Example Business
NEXT_PUBLIC_BUSINESS_PHONE=(555) 555-0100
NEXT_PUBLIC_BUSINESS_EMAIL=hello@example.com
NEXT_PUBLIC_LOGO_URL=/logo-placeholder.svg
NEXT_PUBLIC_PRIMARY_COLOR=#111827
NEXT_PUBLIC_SECONDARY_COLOR=#6B7280
NEXT_PUBLIC_ACCENT_COLOR=#2563EB
NEXT_PUBLIC_DEFAULT_LOCATION=Main Location

# Supabase public client values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only values: never expose these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_your_key
